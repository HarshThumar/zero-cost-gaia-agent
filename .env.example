# Copy to .env and fill in. .env is gitignored — never commit it.

# Hugging Face WRITE token (huggingface.co/settings/tokens).
# Also click "accept" on the gated dataset: https://huggingface.co/datasets/gaia-benchmark/GAIA
# (needed only to fetch question attachments — the course /files endpoint 404s)
HF_TOKEN=

# Web search — serper.dev (2,500 free queries)
SERPER_API_KEY=

# Cloudflare Workers AI — already set as Windows user env vars locally.
# On the Space, add as secrets: CF_AI_ACCOUNT_ID_1..N / CF_AI_TOKEN_1..N
# The agent auto-rotates to the next account on 429 / quota errors.

# Model overrides (optional; these are the defaults)
AGENT_MODEL=@cf/openai/gpt-oss-120b
VISION_MODEL=@cf/google/gemma-4-26b-a4b-it
ASR_MODEL=@cf/openai/whisper-large-v3-turbo
